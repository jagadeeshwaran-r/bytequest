    "params": [
      {
        "name": "s",
        "type": "String"
      },
      {
        "name": "t",
        "type": "String"
      }
    ],
    "returns": "boolean",
    "normalize": "",
    "tests": [
      {
        "args": [
          "listen",
          "silent"
        ],
        "expected": true,
        "label": "Same letters, new order"
      },
      {
        "args": [
          "rat",
          "car"
        ],
        "expected": false,
        "label": "Different letters"
      },
      {
        "args": [
          "aacc",
          "ccac"
        ],
        "expected": false,
        "label": "Counts matter"
      },
      {
        "args": [
          "",
          ""
        ],
        "expected": true,
        "label": "Empty pair"
      },
      {
        "args": [
          "a",
          "aa"
        ],
        "expected": false,
        "label": "Length mismatch"
      }
    ],
    "examples": [
